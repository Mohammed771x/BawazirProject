# انسخ هذا الملف إلى .env ثم ضع مفتاحك الحقيقي فيه.
# ملف .env مستثنى من Git ولن يُرفع أبدًا.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# المفتاح الذي يستخدمه C# للتحدث إلى هذه الخدمة (ليس مفتاح Gemini).
# يمنع أي طرف آخر على الشبكة من استدعاء الخدمة مباشرة.
# مطلوب: الخدمة ترفض الإقلاع بدونه، لأن غيابه يقبل كل المتصلين لا يمنعهم.
# ولّده هكذا:  python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# وضع نفس القيمة في الباكيند:  dotnet user-secrets set "AiService:Token" "…"
AI_SERVICE_TOKEN=

# التعرّف على الكلام في قسم التحدث (ADR-107): Gemini أولًا، و Groq Whisper إذا فشل.
# مفتاح Gemini هنا منفصل عن مفتاح النصوص عمدًا (طبقة مجانية)، ولا يُستبدل به أبدًا.
# كلاهما اختياري: بدونهما يرجع التحدث إلى الكتابة.
STT_GEMINI_API_KEY=
STT_GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3

# صوت المعلّم ونصوص الاستماع (ADR-108, ADR-110): المزوّدون بالترتيب.
# edge أولًا (صوت Ava، بدون مفتاح، غير رسمي) ثم gemini. لتبديل مزوّد عطل: غيّر الترتيب.
# TTS_PROVIDERS=edge,gemini
# TTS_EDGE_VOICE=en-US-AvaMultilingualNeural
# TTS_EDGE_TIMEOUT_SECONDS=20
# TTS_EDGE_PARALLEL=4
# A sentence Edge has not finished after this (+ per character) is asked for
# again, and the first copy back is used. 0 turns it off (ADR-117).
# TTS_EDGE_HEDGE_SECONDS=2.0
# TTS_EDGE_HEDGE_PER_CHAR=0.02
# Gemini (الاحتياطي): صوت "Kore"، وتوقيت كل كلمة من Groq.
# المفتاح الافتراضي هو STT_GEMINI_API_KEY (المجاني) — لا يُستخدم مفتاح النصوص أبدًا.
# كلها اختيارية: بدونها يتكلم التطبيق بصوت الجوال كما كان.
# TTS_GEMINI_API_KEY=
TTS_VOICE=Kore
TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-2.5-flash-preview-tts
# A noise burst at a clip's edge is silenced (ADR-109).
# TTS_BURST_MAX_MS=300
# TTS_BURST_MIN_GAP_MS=100
# TTS_BURST_MIN_RMS=12000
# TTS_CLICK_MAX_MS=30
